# SwarmChat Configuration
SWARM_URL=http://127.0.0.1:8484
SWARM_CHANNEL=#helpdesk
TOKEN_CLIENT=your_client_agent_token
TOKEN_TRIYJ=your_triage_agent_token
TOKEN_ERISIM=your_access_agent_token
TOKEN_DONANIM=your_hardware_agent_token

# Distributed Ollama Architecture (Load Balancing)
OLLAMA_MAIN_URL=http://192.168.1.x:11434/api/chat
MODEL_MAIN=qwen2.5-coder

OLLAMA_HERMES_URL=http://192.168.1.y:11434/api/chat
MODEL_HERMES=hermes3

# Active Directory (Windows DC via WinRM)
DC_IP=192.168.1.z
DC_USER=DOMAIN\svc_helpdesk
DC_PASS=your_service_account_password

# Email Integration (Gmail IMAP/SMTP)
GMAIL_USER=helpdesk-test@gmail.com
GMAIL_APP_PASS=your_16_char_app_password
# Only allow transactions on the AD account that matches your own email address. (true/false)
STRICT_EMAIL_CHECK=true
